{
  "name": "obsidian-emacs-bindings",
  "version": "1.0.0",
  "description": "Obsidian plugin for Emacs Key Bindings",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint --ext .js,.mjs,.ts src test *.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "wdio run ./wdio.conf.mjs",
    "check": "npm run lint && npm run format:check && npm run build && npm run test:unit"
  },
  "keywords": [
    "obsidian",
    "emacs"
  ],
  "author": "Takayuki Kazama",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "6.17.0",
    "@codemirror/commands": "6.6.0",
    "@codemirror/language": "6.10.2",
    "@codemirror/search": "6.5.6",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/common": "1.2.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@wdio/cli": "9.31.7",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.7",
    "@wdio/logger": "9.29.1",
    "@wdio/mocha-framework": "9.31.7",
    "@wdio/spec-reporter": "9.31.2",
    "builtin-modules": "3.3.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^8.6.0",
    "expect-webdriverio": "6.0.10",
    "jsdom": "26.1.0",
    "mocha": "11.8.0",
    "obsidian": "1.13.1",
    "prettier": "^2.8.3",
    "tslib": "2.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "wdio-obsidian-service": "3.2.0",
    "webdriverio": "9.31.7"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0"
  },
  "resolutions": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  }
}
